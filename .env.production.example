# docker-compose.prod.yml environment — copy to .env.production and fill in.
# NEVER commit .env.production.

POSTGRES_USER=aarogyam
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aarogyam

REDIS_PASSWORD=change-me-strong-password

JWT_SECRET=generate-64-char-random-hex
JWT_REFRESH_SECRET=generate-a-different-64-char-random-hex
MFA_ENCRYPTION_KEY=generate-a-third-64-char-random-hex

FRONTEND_URL=https://your-domain.example.com
NEXT_PUBLIC_API_URL=https://api.your-domain.example.com

AI_PROVIDER=openai
AI_ENABLED=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4-turbo-preview

# Optional AWS integrations (leave empty to disable)
AWS_REGION=us-east-1
S3_REPORTS_BUCKET=

LOG_LEVEL=info
DB_POOL_MAX=10

# Optional — error tracking (absent = disabled)
SENTRY_DSN=

# Optional — external NER service for PII stripping beyond regexes.
# POST {text} → {entities:[{text,label}]}. Unset = regex-only. When set,
# a NER timeout/error aborts the LLM call (fail-closed by design).
PII_NER_URL=

# Required only when using --profile monitoring
GRAFANA_ADMIN_PASSWORD=
