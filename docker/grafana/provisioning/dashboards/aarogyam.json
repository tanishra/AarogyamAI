{
  "title": "AarogyamAI — Backend",
  "uid": "aarogyam-backend",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(http_requests_total[5m]))" }]
    },
    {
      "id": 2,
      "title": "p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "id": 3,
      "title": "5xx rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))" }]
    },
    {
      "id": 4,
      "title": "Rate-limit rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum by (bucket) (rate(rate_limit_rejections_total[5m]))" }]
    },
    {
      "id": 5,
      "title": "Account lockouts",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "account_lockouts_total" }]
    },
    {
      "id": 6,
      "title": "LLM circuit open",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "llm_circuit_open" }]
    },
    {
      "id": 7,
      "title": "LLM calls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum by (outcome) (rate(llm_calls_total[5m]))" }]
    },
    {
      "id": 8,
      "title": "DB pool (total/idle/waiting)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "db_pool_total", "legendFormat": "total" },
        { "expr": "db_pool_idle", "legendFormat": "idle" },
        { "expr": "db_pool_waiting", "legendFormat": "waiting" }
      ]
    }
  ]
}
